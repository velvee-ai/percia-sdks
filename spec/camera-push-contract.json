              "watchCount": 0
            },
            "whipUrl": "https://media.percia.test/cam/11111111-2222-3333-4444-555555555555/whip",
            "token": "pc_FAKE_TOKEN_bulk_a_0003"
          },
          {
            "camera": {
              "id": "cam_push_2",
              "name": "Camera b",
              "kind": "push",
              "externalId": "b",
