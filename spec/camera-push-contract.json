              "watchCount": 0
            },
            "whipUrl": "https://media.percia.test/cam/21111111-2222-3333-4444-555555555555/whip",
            "token": null,
            "existing": true
          }
        ]
      }
    },
    "allExisting": {
      "status": 200,
      "body": {
        "cameras": [
          {
