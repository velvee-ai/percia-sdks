{
  "name": "@percia/sdk",
  "version": "0.3.5",
  "description": "TypeScript SDK for the Percia API: typed client, retries, pagination and webhook signature verification. Fetch only; runs on Node 20+, Cloudflare Workers, Deno, Bun and browsers.",
  "license": "MIT",
  "author": "Velvee, Inc. <support@velvee.ai>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./webhooks": {
      "import": { "types": "./dist/webhooks.d.ts", "default": "./dist/webhooks.js" },
      "require": { "types": "./dist/webhooks.d.cts", "default": "./dist/webhooks.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "repository": { "type": "git", "url": "git+https://github.com/velvee-ai/percia-sdks.git", "directory": "typescript" },
  "homepage": "https://www.percia.ai",
  "bugs": { "url": "https://github.com/velvee-ai/percia-sdks/issues", "email": "support@velvee.ai" },
  "keywords": ["percia", "sdk", "api", "webhooks", "camera"],
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "generate": "openapi-ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^22.10.0",
    "tsup": "9.0.0",
    "typescript": "^5.7.0",
    "vitest": "5.1.0"
  }
}
