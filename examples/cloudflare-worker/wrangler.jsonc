{
  "name": "percia-webhook-receiver",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01"
  // The signing secret is NOT in this file. Store it as a secret:
  //   npx wrangler secret put PERCIA_WEBHOOK_SECRET      (paste the whsec_... value)
  // For local `wrangler dev`, put PERCIA_WEBHOOK_SECRET=... in .dev.vars (gitignored, see .dev.vars.example).
  //
  // Optional durable dedupe (see src/index.js): uncomment, then `npx wrangler kv namespace create SEEN`
  // and paste the id.
  // "kv_namespaces": [{ "binding": "SEEN", "id": "<kv-namespace-id>" }]
}
