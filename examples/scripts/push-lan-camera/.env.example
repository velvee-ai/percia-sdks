# Percia API key with cameras:write (dashboard -> API keys). Never commit a real one.
PERCIA_API_KEY=pk_live_replace_me
PERCIA_BASE_URL=https://playground.percia.ai
# The camera's address on YOUR network. Credentials in it stay on this machine.
RTSP_URL=rtsp://user:password@192.168.1.20:554/stream1
# Optional. A stable id makes reruns reuse the same Percia camera (default: derived from RTSP_URL).
# EXTERNAL_ID=front-door-cam
# CAMERA_NAME=Front door
# copy = pass H.264 through (default); transcode = 720p / 10 fps for H.265 or heavy streams
# MODE=copy
