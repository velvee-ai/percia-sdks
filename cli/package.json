{
  "name": "@percia/cli",
  "version": "0.2.0",
  "description": "Command line for Percia: watches, events, cameras, alert destinations, REST hooks, local webhook forwarding and MCP setup.",
  "license": "MIT",
  "type": "module",
  "bin": { "percia": "./dist/bin.js" },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "repository": { "type": "git", "url": "git+https://github.com/percia-ai/percia-sdks.git", "directory": "cli" },
  "homepage": "https://github.com/percia-ai/percia-sdks/tree/main/cli#readme",
  "keywords": ["percia", "cli", "webhooks", "camera", "mcp"],
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/bin.ts",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@percia/sdk": "workspace:*",
    "commander": "^14.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "tsup": "9.0.0",
    "typescript": "^5.7.0",
    "vitest": "5.1.0"
  }
}
